# Mesmo projeto Supabase do App-Compras/Requerimentos (nfijlzndlioefayctbsh) —
# este app usa o schema `hub`. Painel do projeto > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://nfijlzndlioefayctbsh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Exclusiva do servidor. Nunca expor no cliente nem commitar. Mesma chave já
# usada nos outros dois projetos Vercel.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Projeto Supabase SEPARADO do Numera — só leitura de public.users, para o
# importador em Configurações. Não são segredos de verdade (a mesma chave
# já vai hardcoded no client-side do próprio Numera, em app.js), mas ficam
# em env var pelo mesmo padrão dos demais valores deste projeto.
NUMERA_SUPABASE_URL=https://uxdjhdnsnditivvjktzf.supabase.co
NUMERA_SUPABASE_ANON_KEY=sb_publishable_...

# Service role do projeto Numera (segredo de verdade, NUNCA commitar) —
# obrigatória para aprovar o módulo Numera em Configurações → Solicitações
# (cria/aprova conta diretamente no banco do Numera). Painel do projeto
# uxdjhdnsnditivvjktzf > Settings > API. Sem ela, aprovar só o módulo Numera
# falha com mensagem clara; Compras/Requerimentos não dependem dela.
NUMERA_SUPABASE_SERVICE_ROLE_KEY=eyJ...
